    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "admin:dev": "npm --prefix admin-dashboard run dev",
    "admin:build": "npm --prefix admin-dashboard run build",
    "admin:preview": "npm --prefix admin-dashboard run preview",
    "portal:dev": "npm --prefix representative-portal run dev",
    "portal:build": "npm --prefix representative-portal run build",
    "portal:test": "npm --prefix representative-portal run test",
    "portal:verify": "npm --prefix representative-portal run verify",
    "test": "vitest run --exclude firestore.rules.emulator.test.mjs --exclude storage.rules.emulator.test.mjs",
    "test:rules": "node scripts/run-firestore-rules-tests.mjs",
    "start": "expo start",
    "voice:server": "npm --prefix livekit-token-server start",
    "voice:server:install": "npm --prefix livekit-token-server install",
    "voice:tunnel": "npx ngrok http 3001",
    "functions:install": "npm --prefix functions install",
    "functions:lint": "npm --prefix functions run lint",
    "functions:deploy": "npx firebase-tools deploy --only functions",
    "functions:secrets:set": "npx firebase-tools functions:secrets:set",
    "android": "set \"ANDROID_HOME=%LOCALAPPDATA%\\Android\\Sdk\" && set \"ANDROID_SDK_ROOT=%LOCALAPPDATA%\\Android\\Sdk\" && set \"PATH=%LOCALAPPDATA%\\Android\\Sdk\\platform-tools;%PATH%\" && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "private": true
}
