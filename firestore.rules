    function validRoomType(type) {
      return type == 'voice' || type == 'game';
    }

    function validRoomVisibility(visibility) {
      return visibility == 'public' || visibility == 'private';
    }

    function validRoomCountryCode(countryCode) {
      return countryCode == 'IQ'
        || countryCode == 'SA'
        || countryCode == 'SY'
        || countryCode == 'LB'
        || countryCode == 'YE'
        || countryCode == 'DZ'
        || countryCode == 'EG'
        || countryCode == 'JO'
        || countryCode == 'PS'
        || countryCode == 'AE'
        || countryCode == 'KW'
        || countryCode == 'QA'
        || countryCode == 'BH'
        || countryCode == 'OM'
        || countryCode == 'MA'
        || countryCode == 'TN'
        || countryCode == 'LY'
        || countryCode == 'SD'
        || countryCode == 'SO'
        || countryCode == 'DJ'
        || countryCode == 'MR'
        || countryCode == 'KM';
    }

    function validInviteCode(inviteCode) {
      return inviteCode is string
        && inviteCode.size() >= 6
        && inviteCode.size() <= 12
        && inviteCode.matches('^[A-Z0-9]+$');
    }

    function validRoomSeatCount(seatTargetCount) {
      return seatTargetCount == 5
        || seatTargetCount == 10
        || seatTargetCount == 15
        || seatTargetCount == 20;
    }

    function validRoomSeatMode(seatMode) {
      return seatMode == 'open'
        || seatMode == 'request'
        || seatMode == 'invite'
        || seatMode == 'locked';
    }

    function validRoomV2Create(data) {
      return (
        !data.keys().hasAny([
          'schemaVersion',
          'ownerUid',
          'ownerDisplayName',
          'ownerAvatarLabel',
          'revision',
          'ownershipRevision',
          'moderatorCount',
          'audioLockdown',
          'availability',
          'seatTargetCount',
          'seatMode',
        ])
      ) || (
        data.schemaVersion == 2
        && data.ownerUid == request.auth.uid
        && data.ownerUid == data.hostId
        && data.ownerDisplayName == data.hostDisplayName
        && data.ownerAvatarLabel == data.hostAvatarLabel
        && data.revision == 1
        && (!('ownershipRevision' in data) || data.ownershipRevision == 1)
        && (!('moderatorCount' in data) || data.moderatorCount == 0)
        && (!('audioLockdown' in data) || data.audioLockdown == false)
        && data.availability == 'active'
        && validRoomSeatCount(data.seatTargetCount)
        && validRoomSeatMode(data.seatMode)
        && (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 160))
        && (!('welcomeMessage' in data) || (data.welcomeMessage is string && data.welcomeMessage.size() <= 200))
        && (!('themeId' in data) || (data.themeId is string && data.themeId.matches('^[a-z0-9][a-z0-9-]{2,63}$')))
        && (!('chatMode' in data) || data.chatMode in ['everyone', 'followers', 'off'])
        && (!('slowModeSeconds' in data) || data.slowModeSeconds in [0, 5, 10, 30, 60])
        && (!('historyVisibility' in data) || data.historyVisibility in ['everyone', 'after-join', 'hidden'])
        && (!('keywordFilterMode' in data) || data.keywordFilterMode in ['off', 'standard', 'strict'])
        && (!('effectsPolicy' in data) || data.effectsPolicy in ['full', 'reduced', 'off'])
        && (!('roomImageReviewStatus' in data) || data.roomImageReviewStatus == 'none')
        && (!('roomCustomizationSuspended' in data) || data.roomCustomizationSuspended == false)
        && !data.keys().hasAny([
          'activeRoomImageId',
          'activeRoomImagePath',
          'pendingRoomImageId',
          'pendingRoomImagePath',
        ])
      );
    }

    function validActiveRoom(roomId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'id',
          'title',
          'type',
          'countryCode',
          'hostId',
          'ownerUid',
          'ownerDisplayName',
          'ownerAvatarLabel',
          'hostDisplayName',
          'hostAvatarLabel',
          'status',
          'visibility',
          'participantCount',
          'speakerCount',
          'schemaVersion',
          'revision',
          'ownershipRevision',
          'moderatorCount',
          'audioLockdown',
          'availability',
          'seatTargetCount',
          'seatMode',
          'announcement',
          'welcomeMessage',
          'themeId',
          'chatMode',
          'slowModeSeconds',
          'historyVisibility',
          'keywordFilterMode',
          'effectsPolicy',
          'roomImageReviewStatus',
          'roomCustomizationSuspended',
          'inviteCode',
          'currentGameId',
          'createdAt',
          'updatedAt',
        ])
        && data.id == roomId
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 48
        && validRoomType(data.type)
        && (!('countryCode' in data) || validRoomCountryCode(data.countryCode))
        && data.hostId == request.auth.uid
        && data.hostDisplayName == get(profilePath(request.auth.uid)).data.displayName
        && data.hostAvatarLabel == get(profilePath(request.auth.uid)).data.avatarLabel
        && data.status == 'active'
        && validRoomVisibility(data.visibility)
        && data.participantCount == 1
        && (
          (!('schemaVersion' in data) && !('speakerCount' in data))
          || (data.schemaVersion == 2 && data.speakerCount == 0)
        )
        && validRoomV2Create(data)
        && (
          (data.visibility == 'public' && !('inviteCode' in data)) ||
          (data.visibility == 'private' && validInviteCode(data.inviteCode))
        )
        && (!('currentGameId' in data) || data.currentGameId is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function memberPath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(userId);
    }

    function roomBanPath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/bans/$(userId);
    }

    function hasActiveRoomBan(roomId, userId) {
      let path = roomBanPath(roomId, userId);
      return exists(path)
        && get(path).data.status == 'active'
        && (!('expiresAt' in get(path).data) || get(path).data.expiresAt > request.time);
    }

    function validOptionalMemberV2(data, room) {
      return (
        !data.keys().hasAny(['schemaVersion', 'authorityRole', 'seatId', 'privileges'])
      ) || (
        data.schemaVersion == 2
        && data.authorityRole == (room.hostId == request.auth.uid ? 'owner' : 'member')
        && data.seatId == null
        && data.privileges is map
        && data.privileges.keys().hasOnly(['canManageMusic'])
        && data.privileges.canManageMusic == false
      );
    }

    function validMember(roomId, userId) {
      let data = request.resource.data;
      let room = getAfter(roomPath(roomId)).data;
      return data.keys().hasOnly([
          'uid',
          'displayName',
          'avatarLabel',
          'role',
          'status',
          'canPublishAudio',
          'schemaVersion',
          'authorityRole',
          'seatId',
          'privileges',
          'inviteCodeUsed',
          'joinedAt',
          'updatedAt',
        ])
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName == get(profilePath(request.auth.uid)).data.displayName
        && data.avatarLabel == get(profilePath(request.auth.uid)).data.avatarLabel
        && (
          (room.hostId == request.auth.uid && data.role == 'host' && data.canPublishAudio == true) ||
          (
            room.hostId != request.auth.uid
            && data.role == 'listener'
            && data.canPublishAudio == false
            && (
              (room.visibility == 'public' && !('inviteCodeUsed' in data)) ||
              (room.visibility == 'private' && data.inviteCodeUsed == room.inviteCode)
            )
          )
        )
        && data.status == 'active'
        && !hasActiveRoomBan(roomId, userId)
        && (!('softMatch' in room) || room.softMatch != true)
        && validOptionalMemberV2(data, room)
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validMemberRefresh(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid',
          'displayName',
          'avatarLabel',
          'role',
          'status',
          'canPublishAudio',
          'schemaVersion',
          'authorityRole',
          'seatId',
          'privileges',
          'forceMuted',
          'updatedBy',
          'removedAt',
          'removedBy',
          'inviteCodeUsed',
          'joinedAt',
          'updatedAt',
        ])
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName == get(profilePath(request.auth.uid)).data.displayName
        && data.avatarLabel == get(profilePath(request.auth.uid)).data.avatarLabel
        && data.role == resource.data.role
        && data.status == resource.data.status
        && data.canPublishAudio == resource.data.canPublishAudio
        && (
          (!('forceMuted' in resource.data) && !('forceMuted' in data)) ||
          data.forceMuted == resource.data.forceMuted
        )
        && (
          (!('updatedBy' in resource.data) && !('updatedBy' in data)) ||
          data.updatedBy == resource.data.updatedBy
        )
        && (
          (!('removedAt' in resource.data) && !('removedAt' in data)) ||
          data.removedAt == resource.data.removedAt
        )
        && (
          (!('removedBy' in resource.data) && !('removedBy' in data)) ||
          data.removedBy == resource.data.removedBy
        )
        && (
          (
            !resource.data.keys().hasAny(['schemaVersion', 'authorityRole', 'seatId', 'privileges'])
            && !data.keys().hasAny(['schemaVersion', 'authorityRole', 'seatId', 'privileges'])
          ) ||
          (
            data.schemaVersion == resource.data.schemaVersion
            && data.authorityRole == resource.data.authorityRole
            && data.seatId == resource.data.seatId
            && data.privileges == resource.data.privileges
          )
        )
        && (
          (!('inviteCodeUsed' in resource.data) && !('inviteCodeUsed' in data)) ||
          data.inviteCodeUsed == resource.data.inviteCodeUsed
        )
        && data.joinedAt == resource.data.joinedAt
        && data.updatedAt is timestamp;
    }

    function validPresenceStatus(status) {
      return status == 'online' || status == 'reconnecting' || status == 'stale';
    }

    function canManageRoomSeats(roomId) {
      let room = get(roomPath(roomId)).data;
      let member = get(memberPath(roomId, request.auth.uid)).data;
      return hasCompleteProfile()
        && exists(memberPath(roomId, request.auth.uid))
        && member.status == 'active'
        && (
          request.auth.uid == room.ownerUid
          || request.auth.uid == room.hostId
          || member.authorityRole == 'moderator'
        );
    }

    function roomSeatIdMatches(seatId, seatNumber) {
      return (seatId == '01' && seatNumber == 1)
        || (seatId == '02' && seatNumber == 2)
        || (seatId == '03' && seatNumber == 3)
        || (seatId == '04' && seatNumber == 4)
        || (seatId == '05' && seatNumber == 5)
        || (seatId == '06' && seatNumber == 6)
        || (seatId == '07' && seatNumber == 7)
        || (seatId == '08' && seatNumber == 8)
        || (seatId == '09' && seatNumber == 9)
        || (seatId == '10' && seatNumber == 10)
        || (seatId == '11' && seatNumber == 11)
        || (seatId == '12' && seatNumber == 12)
        || (seatId == '13' && seatNumber == 13)
        || (seatId == '14' && seatNumber == 14)
        || (seatId == '15' && seatNumber == 15)
        || (seatId == '16' && seatNumber == 16)
        || (seatId == '17' && seatNumber == 17)
        || (seatId == '18' && seatNumber == 18)
        || (seatId == '19' && seatNumber == 19)
        || (seatId == '20' && seatNumber == 20);
    }

    function validInitialRoomSeat(roomId, seatId) {
      let data = request.resource.data;
      let room = getAfter(roomPath(roomId)).data;
      return hasCompleteProfile()
        && room.schemaVersion == 2
        && room.ownerUid == request.auth.uid
        && data.keys().hasOnly(['schemaVersion', 'seatNumber', 'state', 'revision', 'updatedAt'])
        && data.schemaVersion == 2
        && roomSeatIdMatches(seatId, data.seatNumber)
        && data.state == 'open'
        && data.revision == 1
        && data.updatedAt is timestamp;
    }

    function canReadPresence(roomId) {
      return hasCompleteProfile()
        && get(roomPath(roomId)).data.status == 'active'
        && exists(memberPath(roomId, request.auth.uid))
        && get(memberPath(roomId, request.auth.uid)).data.status == 'active';
    }

    function hasActiveRoomMembership(roomId) {
      return hasCompleteProfile()
        && roomId is string
        && roomId.size() >= 1
        && roomId.size() <= 128
        && exists(memberPath(roomId, request.auth.uid))
        && get(memberPath(roomId, request.auth.uid)).data.uid == request.auth.uid
        && get(memberPath(roomId, request.auth.uid)).data.status == 'active';
    }

    function validCrossRoomPkIdentity(data) {
      return data.schemaVersion == 2
        && data.mode == 'cross-room'
        && data.redRoomId is string
        && data.blueRoomId is string
        && data.redRoomId != data.blueRoomId
        && data.roomId == data.redRoomId
        && data.roomIds is list
        && data.roomIds.size() == 2
        && data.roomIds[0] == data.redRoomId
        && data.roomIds[1] == data.blueRoomId;
    }

    function canReadCrossRoomPkData(data) {
      return validCrossRoomPkIdentity(data)
        && (
          hasActiveRoomMembership(data.redRoomId)
          || hasActiveRoomMembership(data.blueRoomId)
        );
    }

    function canReadRoomPkSession() {
      return signedIn()
        && (
          (
            resource.data.schemaVersion == 1
            && resource.data.mode != 'cross-room'
            && resource.data.roomId is string
            && canReadPresence(resource.data.roomId)
          )
          || canReadCrossRoomPkData(resource.data)
        );
    }

    function canReadRoomPkChallenge() {
      return signedIn()
        && resource.data.schemaVersion == 1
        && resource.data.mode == 'cross-room'
        && resource.data.challengerRoomId is string
        && resource.data.opponentRoomId is string
        && resource.data.challengerRoomId != resource.data.opponentRoomId
        && (
          hasActiveRoomMembership(resource.data.challengerRoomId)
          || hasActiveRoomMembership(resource.data.opponentRoomId)
        );
    }

    function voiceRoomFeaturePath() {
      return /databases/$(database)/documents/appConfig/voiceRoomFeatures;
    }

    function voiceRoomLaunchPath() {
      return /databases/$(database)/documents/appConfig/voiceRoomLaunch;
    }

    function roomLaunchAllowsAccess() {
      let launchPath = voiceRoomLaunchPath();
      return exists(launchPath)
        && (
          get(launchPath).data.status == 'testing'
          || get(launchPath).data.status == 'active'
        )
        && get(launchPath).data.recordingDecision == 'rejected'
        && (
          isAdmin()
          || (
            get(launchPath).data.allowedUids is list
            && request.auth.uid in get(launchPath).data.allowedUids
          )
          || (
            get(launchPath).data.audienceMode == 'public'
            && get(launchPath).data.stageId == 10
            && 'broadReleaseReady' in get(launchPath).data
            && get(launchPath).data.broadReleaseReady == true
          )
          || (
            get(launchPath).data.audienceMode == 'region'
            && get(launchPath).data.allowedRegionCodes is list
            && exists(publicProfilePath(request.auth.uid))
            && get(publicProfilePath(request.auth.uid)).data.countryCode
              in get(launchPath).data.allowedRegionCodes
          )
        );
    }

    function roomNewJoinsAllowed() {
      return !exists(voiceRoomFeaturePath())
        || !('voice_room_new_joins' in get(voiceRoomFeaturePath()).data)
        || get(voiceRoomFeaturePath()).data.voice_room_new_joins != false;
    }

    function roomChatEnabled() {
      return exists(voiceRoomFeaturePath())
        && get(voiceRoomFeaturePath()).data.voice_room_chat == true;
    }

    function roomGamesEnabled() {
      return exists(voiceRoomFeaturePath())
        && get(voiceRoomFeaturePath()).data.voice_room_games == true;
    }

    function roomMusicEnabled() {
      return exists(voiceRoomFeaturePath())
        && get(voiceRoomFeaturePath()).data.voice_room_shared_music == true;
    }

    function roomWatchEnabled() {
      return exists(/databases/$(database)/documents/appConfig/growthFeatures)
        && get(/databases/$(database)/documents/appConfig/growthFeatures).data.watchTogether == true;
    }

    function roomSupportRankingsEnabled() {
      return exists(voiceRoomFeaturePath())
        && get(voiceRoomFeaturePath()).data.voice_room_supporter_rankings == true;
    }

    function roomTargetsEnabled() {
      return exists(voiceRoomFeaturePath())
        && get(voiceRoomFeaturePath()).data.voice_room_owner_targets == true;
    }

    function roomPresencePath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/presence/$(userId);
    }

    function hasLiveReconnectPresence(roomId, userId) {
      let presencePath = roomPresencePath(roomId, userId);
      return exists(presencePath)
        && get(presencePath).data.uid == userId
        && (
          get(presencePath).data.status == 'online'
          || get(presencePath).data.status == 'reconnecting'
        )
        && get(presencePath).data.leaseExpiresAt >= request.time;
    }

    function canReadRoomChat(roomId) {
      return roomChatEnabled()
        && canReadPresence(roomId);
    }

    function canReadRoomMessage(roomId) {
      let room = get(roomPath(roomId)).data;
      let member = get(memberPath(roomId, request.auth.uid)).data;
      let presencePath = roomPresencePath(roomId, request.auth.uid);
      return canReadRoomChat(roomId)
        && (
          resource.data.kind == 'moderation'
          || !('historyVisibility' in room)
          || room.historyVisibility == 'everyone'
          || (
            room.historyVisibility == 'after-join'
            && resource.data.createdAt >= member.joinedAt
          )
          || (
            room.historyVisibility == 'hidden'
            && exists(presencePath)
            && resource.data.createdAt >= get(presencePath).data.joinedAt
          )
        );
    }

    function validOwnPresence(roomId, userId) {
      let data = request.resource.data;
      let member = get(memberPath(roomId, userId)).data;
      return hasCompleteProfile()
        && request.auth.uid == userId
        && get(roomPath(roomId)).data.status == 'active'
        && exists(memberPath(roomId, userId))
        && member.status == 'active'
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'avatarLabel',
          'role',
          'status',
          'canPublishAudio',
          'authorityRole',
          'seatId',
          'sessionId',
          'leaseExpiresAt',
          'joinedAt',
          'lastSeenAt',
          'updatedAt',
        ])
        && data.uid == userId
        && data.displayName == get(profilePath(request.auth.uid)).data.displayName
        && data.avatarLabel == get(profilePath(request.auth.uid)).data.avatarLabel
        && data.role == member.role
        && data.canPublishAudio == member.canPublishAudio
        && data.authorityRole == (
          'authorityRole' in member
            ? member.authorityRole
            : (member.role == 'host' ? 'owner' : 'member')
        )
        && data.seatId == ('seatId' in member ? member.seatId : null)
        && data.sessionId is string
        && data.sessionId.size() >= 16
        && data.sessionId.size() <= 160
        && data.leaseExpiresAt is timestamp
        && data.leaseExpiresAt <= request.time + duration.value(60, 's')
        && validPresenceStatus(data.status)
        && data.joinedAt is timestamp
        && data.lastSeenAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validJoinCountUpdate(roomId) {
      return roomNewJoinsAllowed()
        && roomLaunchAllowsAccess()
        && hasCompleteProfile()
        && resource.data.status == 'active'
        && !exists(memberPath(roomId, request.auth.uid))
        && getAfter(memberPath(roomId, request.auth.uid)).data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount', 'updatedAt'])
        && request.resource.data.participantCount == resource.data.participantCount + 1
        && request.resource.data.updatedAt is timestamp;
    }

    function canReadRoom(roomId) {
      return hasCompleteProfile()
        && roomLaunchAllowsAccess()
        && resource.data.status == 'active'
        && (
          resource.data.visibility == 'public' ||
          (exists(memberPath(roomId, request.auth.uid)) && get(memberPath(roomId, request.auth.uid)).data.status == 'active')
        );
    }

    match /rooms/{roomId} {
      allow get: if canReadRoom(roomId);
      allow list: if hasCompleteProfile()
        && roomLaunchAllowsAccess()
        && resource.data.status == 'active'
        && (
          resource.data.visibility == 'public' ||
          resource.data.hostId == request.auth.uid
        );
      allow create: if hasCompleteProfile()
        && roomNewJoinsAllowed()
        && roomLaunchAllowsAccess()
        && validActiveRoom(roomId)
        && getAfter(memberPath(roomId, request.auth.uid)).data.role == 'host';
      allow update: if validJoinCountUpdate(roomId);
      allow delete: if false;

      match /members/{userId} {
        allow get: if hasCompleteProfile() && request.auth.uid == userId;
        allow list: if false;
        allow create: if hasCompleteProfile()
          && roomNewJoinsAllowed()
          && roomLaunchAllowsAccess()
          && request.auth.uid == userId
          && getAfter(roomPath(roomId)).data.status == 'active'
          && validMember(roomId, userId);
        allow update: if hasCompleteProfile()
          && request.auth.uid == userId
          && roomLaunchAllowsAccess()
          && (
            roomNewJoinsAllowed()
            || hasLiveReconnectPresence(roomId, userId)
          )
          && validMemberRefresh(userId);
        allow delete: if false;
      }

      match /moderationEvents/{eventId} {
        allow read: if canManageRoomSeats(roomId);
        allow write: if false;
      }

      match /commandRequests/{requestId} {
        allow read, write: if false;
      }

      match /themeEntitlements/{themeId} {
        allow read, write: if false;
      }

      match /ownershipTransferRequests/{requestId} {
        allow read, write: if false;
      }

      match /ownershipTransfers/{transferId} {
        allow get, list: if hasActivePublicProfile()
          && resource.data.roomId == roomId
          && (
            request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid
          );
        allow write: if false;
      }

      match /giftCommandRequests/{requestId} {
        allow read, write: if false;
      }

      match /giftQuotes/{quoteId} {
        allow read, write: if false;
      }

      match /giftEvents/{eventId} {
        allow read: if false;
        allow write: if false;
      }

      match /giftContributions/{userId} {
        allow read: if false;
        allow write: if false;
      }

      match /giftCombos/{comboId} {
        allow read, write: if false;
      }

      match /supportPeriods/{periodId}/{document=**} {
        allow read, write: if false;
      }

      match /supportLeaderboards/{periodId} {
        allow get, list: if roomSupportRankingsEnabled() && canReadPresence(roomId);
        allow write: if false;
      }

      match /rocketCycles/{cycleId} {
        allow get, list: if roomSupportRankingsEnabled() && canReadPresence(roomId);
        allow write: if false;
      }

      match /targetCycles/{document=**} {
        allow read, write: if false;
      }

      match /targetRosterDrafts/{cycleId} {
        allow read, write: if false;
      }

      match /targetPublicCycles/{cycleId} {
        allow get, list: if roomTargetsEnabled() && canReadPresence(roomId);
        allow write: if false;
      }

      match /targetRosterPreviews/{cycleId} {
        allow get: if roomTargetsEnabled()
          && hasActivePublicProfile()
          && resource.data.roomId == roomId
          && resource.data.ownerUid == request.auth.uid;
        allow list, write: if false;
      }

      match /entryEffectRequests/{requestId} {
        allow read, write: if false;
      }

      match /entryEffectClaims/{claimId} {
        allow read, write: if false;
      }

      match /coupleEntryClaims/{claimId} {
        allow read, write: if false;
      }

      match /entryEffectRateLimits/{userId} {
        allow read, write: if false;
      }

      match /reactionRequests/{requestId} {
        allow read, write: if false;
      }

      match /reactionRateLimits/{userId} {
        allow read, write: if false;
      }

      match /reactionRoomRateLimits/{rateId} {
        allow read, write: if false;
      }

      match /gameCommandRequests/{requestId} {
        allow read, write: if false;
      }

      match /gameCommandRateLimits/{userId} {
        allow read, write: if false;
      }

      match /gameRewardClaims/{rewardId} {
        allow read, write: if false;
      }

      match /gameSessions/{sessionId} {
        allow read: if roomGamesEnabled() && canReadPresence(roomId);
        allow write: if false;
      }

      match /pkCommandRequests/{requestId} {
        allow read, write: if false;
      }

      match /musicCommandRequests/{requestId} {
        allow read, write: if false;
      }

      match /musicLeases/{leaseId} {
        allow read: if roomMusicEnabled() && canReadPresence(roomId);
        allow write: if false;
      }

      match /watchCommandRequests/{requestId} {
        allow read, write: if false;
      }

      match /watchLeases/{leaseId} {
        allow read: if roomWatchEnabled() && canReadPresence(roomId);
        allow write: if false;
      }

      match /recordingCommandRequests/{requestId} {
        allow read, write: if false;
      }

      match /recordingSessions/{sessionId} {
        allow read: if canReadPresence(roomId);
        allow write: if false;
      }

      match /recordingSegments/{segmentId} {
        allow read, write: if false;
      }

      match /recordingNoticeAcks/{userId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if canReadPresence(roomId);
        allow write: if false;
      }

      match /chatRequests/{requestId} {
        allow read, write: if false;
      }

      match /chatRateLimits/{userId} {
        allow read, write: if false;
      }

      match /commandRateLimits/{userId} {
        allow read, write: if false;
      }

      match /giftRateLimits/{userId} {
        allow read, write: if false;
      }

      match /chatState/{stateId} {
        allow read: if canReadRoomChat(roomId);
        allow write: if false;
      }

      match /seats/{seatId} {
        allow read: if canReadPresence(roomId);
        allow create: if validInitialRoomSeat(roomId, seatId);
        allow update, delete: if false;
      }

      match /seatRequests/{requestId} {
        allow read: if hasCompleteProfile()
          && (request.auth.uid == resource.data.requesterUid || canManageRoomSeats(roomId));
        allow write: if false;
      }

      match /seatInvites/{targetUid} {
        allow read: if hasCompleteProfile()
          && (request.auth.uid == targetUid || canManageRoomSeats(roomId));
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if canReadRoomMessage(roomId);
        allow write: if false;
      }

      match /bans/{userId} {
        allow read: if canManageRoomSeats(roomId);
        allow write: if false;
      }

      match /presence/{userId} {
        allow get, list: if canReadPresence(roomId);
        allow create, update: if validOwnPresence(roomId, userId);
        allow delete: if false;
      }
    }

    match /roomEvidence/{evidenceId} {
      allow read, write: if false;
    }

    match /roomEvidenceAccessLogs/{logId} {
      allow read, write: if false;
    }

    match /roomModerationNotifications/{ownerUid}/items/{notificationId} {
      allow read: if isOwner(ownerUid);
      allow write: if false;
    }

    match /roomModerationAppeals/{appealId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'eligible'
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.status == 'submitted'
        && request.resource.data.appealText is string
        && request.resource.data.appealText.size() >= 10
        && request.resource.data.appealText.size() <= 1000
        && request.resource.data.submittedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['appealText', 'status', 'submittedAt']);
      allow create, delete: if false;
    }

    match /roomPkSessions/{pkId} {
      allow read: if canReadRoomPkSession();
      allow write: if false;

      match /scoreShards/{shardId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/roomPkSessions/$(pkId))
          && (
            (
              get(/databases/$(database)/documents/roomPkSessions/$(pkId)).data.schemaVersion == 1
              && get(/databases/$(database)/documents/roomPkSessions/$(pkId)).data.mode != 'cross-room'
              && canReadPresence(get(/databases/$(database)/documents/roomPkSessions/$(pkId)).data.roomId)
            )
            || (
              canReadCrossRoomPkData(
                get(/databases/$(database)/documents/roomPkSessions/$(pkId)).data
              )
            )
          );
        allow write: if false;
      }

      match /gifters/{gifterId} {
        allow read, write: if false;
      }
    }

    match /roomPkChallenges/{challengeId} {
      allow read: if canReadRoomPkChallenge();
      allow write: if false;
    }

    match /roomPkGiftFacts/{eventId} {
      allow read, write: if false;
    }

    match /roomPkRateLimits/{uid} {
      allow read, write: if false;
    }

    match /roomPkReconciliations/{pkId} {
      allow read, write: if false;

      match /gifters/{gifterId} {
        allow read, write: if false;
      }
    }

    match /crossRoomPkRoomRateLimits/{roomId} {
      allow read, write: if false;
    }

    match /crossRoomPkPairCooldowns/{pairId} {
      allow read, write: if false;
    }

    match /roomPkAuditEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
