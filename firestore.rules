rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && (!request.auth.token.keys().hasAll(['accountDeletionPending']) || request.auth.token.accountDeletionPending != true);
    }

    function authenticated() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return verified()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function profilePath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function hasCompleteProfile() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.uid == request.auth.uid
        && get(profilePath(request.auth.uid)).data.email == request.auth.token.email
        && get(profilePath(request.auth.uid)).data.displayName is string
        && get(profilePath(request.auth.uid)).data.displayName.size() >= 2
        && get(profilePath(request.auth.uid)).data.displayName.size() <= 32
        && get(profilePath(request.auth.uid)).data.avatarLabel is string
        && get(profilePath(request.auth.uid)).data.avatarLabel.size() >= 1
        && get(profilePath(request.auth.uid)).data.avatarLabel.size() <= 1;
    }

    function validProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'avatarLabel',
          'createdAt',
          'updatedAt',
        ])
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.email == request.auth.token.email
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 32
        && data.avatarLabel is string
        && data.avatarLabel.size() >= 1
        && data.avatarLabel.size() <= 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function publicProfilePath(userId) {
      return /databases/$(database)/documents/publicProfiles/$(userId);
    }

    function hasActivePublicProfile() {
      return signedIn()
        && exists(publicProfilePath(request.auth.uid))
        && get(publicProfilePath(request.auth.uid)).data.uid == request.auth.uid
        && get(publicProfilePath(request.auth.uid)).data.moderationStatus == 'active';
    }

    function blockPath(blockerId, blockedId) {
      return /databases/$(database)/documents/blocks/$(blockerId)/blocked/$(blockedId);
    }

    function isBlockedBetween(userId) {
      return exists(blockPath(request.auth.uid, userId))
        || exists(blockPath(userId, request.auth.uid));
    }

    function directChatFeaturesPath() {
      return /databases/$(database)/documents/appConfig/socialFeatures;
    }

    function directMessagesEnabled() {
      return signedIn()
        && exists(directChatFeaturesPath())
        && get(directChatFeaturesPath()).data.directMessages == true;
    }

    function directConversationPath(conversationId) {
      return /databases/$(database)/documents/directConversations/$(conversationId);
    }

    function isDirectChatMember(conversationId) {
      return directMessagesEnabled()
        && hasActivePublicProfile()
        && exists(directConversationPath(conversationId))
        && get(directConversationPath(conversationId)).data.memberUids is list
        && get(directConversationPath(conversationId)).data.memberUids.size() == 2
        && request.auth.uid in get(directConversationPath(conversationId)).data.memberUids;
    }

    function directChatPeer(conversationId) {
      let members = get(directConversationPath(conversationId)).data.memberUids;
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    function isAcceptedDirectChatMember(conversationId) {
      return isDirectChatMember(conversationId)
        && get(directConversationPath(conversationId)).data.lifecycleState == 'active'
        && get(directConversationPath(conversationId)).data.requestState == 'accepted';
    }

    function hasActiveDirectChatRestriction() {
      let path = /databases/$(database)/documents/directChatRestrictions/$(request.auth.uid);
      return exists(path)
        && get(path).data.state == 'restricted'
        && !('endsAt' in get(path).data && get(path).data.endsAt <= request.time);
    }

    function isCurrentDirectChatFriend(conversationId) {
      let conversation = get(directConversationPath(conversationId)).data;
      return conversation.friendshipId is string
        && exists(/databases/$(database)/documents/friendships/$(conversation.friendshipId));
    }

    function validDirectChatPresence(conversationId, userId, kind) {
      let data = request.resource.data;
      return userId == request.auth.uid
        && isAcceptedDirectChatMember(conversationId)
        && !hasActiveDirectChatRestriction()
        && !isBlockedBetween(directChatPeer(conversationId))
        && data.keys().hasOnly(['conversationId', 'expiresAt', 'kind', 'uid', 'updatedAt', 'value'])
        && data.conversationId == conversationId
        && data.uid == userId
        && data.kind == kind
        && data.updatedAt is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(2, 'm')
        && (
          (kind == 'typing' && data.value == true)
          || (kind == 'online' && data.value == 'online' && isCurrentDirectChatFriend(conversationId))
        );
    }

    function validSocialCountryCode(countryCode) {
      return countryCode == 'IQ'
        || countryCode == 'SA'
        || countryCode == 'SY'
        || countryCode == 'LB'
        || countryCode == 'YE'
        || countryCode == 'DZ'
        || countryCode == 'EG'
        || countryCode == 'JO'
        || countryCode == 'PS'
        || countryCode == 'AE'
        || countryCode == 'KW'
        || countryCode == 'QA'
        || countryCode == 'BH'
        || countryCode == 'OM'
        || countryCode == 'MA'
        || countryCode == 'TN'
        || countryCode == 'LY'
        || countryCode == 'SD'
        || countryCode == 'SO'
        || countryCode == 'DJ'
        || countryCode == 'MR'
        || countryCode == 'KM';
    }

    function validLegacyVipTier(value) {
      return value is map
        && value.keys().hasOnly(['accentColor', 'id', 'nameAr', 'rank', 'unlockedAt'])
        && value.keys().hasAll(['accentColor', 'id', 'nameAr', 'rank'])
        && value.accentColor is string
        && value.accentColor.matches('^#[A-Fa-f0-9]{6}$')
        && value.id is string
        && value.id.matches('^[a-z0-9][a-z0-9_-]{2,39}$')
        && value.nameAr is string
        && value.nameAr.size() >= 1
        && value.nameAr.size() <= 40
        && value.rank is int
        && value.rank >= 1
        && value.rank <= 99
        && (!('unlockedAt' in value) || value.unlockedAt is timestamp);
    }

    function validStatusVipProjection(value) {
      return value is map
        && value.keys().hasOnly(['catalogVersion', 'id', 'band', 'level', 'order', 'nameAr', 'nameEn', 'accentColor', 'assets'])
        && value.keys().hasAll(['catalogVersion', 'id', 'band', 'level', 'order', 'nameAr', 'nameEn', 'accentColor', 'assets'])
        && value.catalogVersion is string
        && value.catalogVersion.matches('^[a-z0-9][a-z0-9_-]{2,79}$')
        && value.id is string
        && (
          (value.band == 'vip' && value.id.matches('^vip-([1-9]|1[0-9]|20)$'))
          || (value.band == 'svip' && value.id.matches('^svip-([1-9]|1[0-9]|20)$'))
        )
        && value.level is int
        && value.level >= 1
        && value.level <= 20
        && value.order is int
        && value.order >= 1
        && value.order <= 40
        && value.nameAr is string
        && value.nameAr.size() >= 1
        && value.nameAr.size() <= 40
        && value.nameEn is string
        && value.nameEn.size() >= 1
        && value.nameEn.size() <= 40
        && value.accentColor is string
        && value.accentColor.matches('^#[A-Fa-f0-9]{6}$')
        && validStatusAssets(value.assets);
    }

    function validStatusAristocracyProjection(value) {
      return value is map
        && value.keys().hasOnly(['catalogVersion', 'id', 'order', 'nameAr', 'nameEn', 'accentColor', 'assets'])
        && value.keys().hasAll(['catalogVersion', 'id', 'order', 'nameAr', 'nameEn', 'accentColor', 'assets'])
        && value.catalogVersion is string
        && value.catalogVersion.matches('^[a-z0-9][a-z0-9_-]{2,79}$')
        && value.id is string
        && value.id.matches('^[a-z0-9][a-z0-9_-]{2,39}$')
        && value.order is int
        && value.order >= 1
        && value.order <= 20
        && value.nameAr is string
        && value.nameAr.size() >= 1
        && value.nameAr.size() <= 40
        && value.nameEn is string
        && value.nameEn.size() >= 1
        && value.nameEn.size() <= 40
        && value.accentColor is string
        && value.accentColor.matches('^#[A-Fa-f0-9]{6}$')
        && validStatusAssets(value.assets);
    }

    function validStatusAssetReference(value) {
      return value is map
        && value.keys().hasOnly(['assetId', 'assetVersionId'])
        && value.keys().hasAll(['assetId', 'assetVersionId'])
        && value.assetId is string
        && value.assetId.matches('^[a-z0-9][a-z0-9_-]{2,79}$')
        && value.assetVersionId is string
        && value.assetVersionId.matches('^v[1-9][0-9]{0,8}-[a-f0-9]{12}$');
    }

    function validStatusAssets(value) {
      return value is map
        && value.keys().hasOnly(['badge', 'frame', 'nameplate', 'chatBubble', 'entryEffect'])
        && (
          value.size() == 0
          || (
            (!('badge' in value) || validStatusAssetReference(value.badge))
            && (!('frame' in value) || validStatusAssetReference(value.frame))
            && (!('nameplate' in value) || validStatusAssetReference(value.nameplate))
            && (!('chatBubble' in value) || validStatusAssetReference(value.chatBubble))
            && (!('entryEffect' in value) || validStatusAssetReference(value.entryEffect))
          )
        );
    }

    function validStatusPresentation(value) {
      return value is map
        && value.keys().hasOnly(['schemaVersion', 'visibility', 'vip', 'aristocracy'])
        && value.keys().hasAll(['schemaVersion', 'visibility'])
        && value.schemaVersion == 1
        && (value.visibility == 'public' || value.visibility == 'hidden')
        && (
          value.visibility == 'public'
          || (!('vip' in value) && !('aristocracy' in value))
        )
        && (!('vip' in value) || validStatusVipProjection(value.vip))
        && (!('aristocracy' in value) || validStatusAristocracyProjection(value.aristocracy));
    }

    function validPublicProfile(userId, data) {
      return data.keys().hasOnly([
          'uid',
          'publicId',
          'specialId',
          'displayName',
          'normalizedName',
          'avatarUrl',
          'countryCode',
          'bio',
          'gender',
          'giftScore',
          'friendCount',
          'followerCount',
          'followingCount',
          'coupleLevel',
          'coupleEffect',
          'vipTier',
          'statusPresentation',
          'equippedAvatarFrame',
          'equippedCosmetics',
          'moderationStatus',
          'avatarModerationStatus',
          'createdAt',
          'updatedAt',
        ])
        && data.keys().hasAll([
          'uid',
          'publicId',
          'displayName',
          'normalizedName',
          'avatarUrl',
          'countryCode',
          'bio',
          'giftScore',
          'friendCount',
          'coupleLevel',
          'moderationStatus',
          'avatarModerationStatus',
          'createdAt',
          'updatedAt',
        ])
        && data.uid == userId
        && data.publicId is string
        && data.publicId.matches('^[1-9][0-9]{6}$')
        && (!('specialId' in data) || (data.specialId is string && data.specialId.matches('^[0-9]{7}$')))
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 32
        && data.normalizedName is string
        && data.normalizedName.size() >= 2
        && data.normalizedName.size() <= 64
        && data.avatarUrl is string
        && data.avatarUrl.size() <= 2048
        && validSocialCountryCode(data.countryCode)
        && data.bio is string
        && data.bio.size() <= 160
        && (!('gender' in data) || data.gender == 'male' || data.gender == 'female')
        && data.giftScore is int
        && data.giftScore >= 0
        && data.friendCount is int
        && data.friendCount >= 0
        && (!('followerCount' in data) || (data.followerCount is int && data.followerCount >= 0))
        && (!('followingCount' in data) || (data.followingCount is int && data.followingCount >= 0))
        && data.coupleLevel is int
        && data.coupleLevel >= 0
        && (!('coupleEffect' in data) || validCoupleEffectProjection(data.coupleEffect))
        && (!('vipTier' in data) || data.vipTier == null || validLegacyVipTier(data.vipTier))
        && (!('statusPresentation' in data) || validStatusPresentation(data.statusPresentation))
        && (
          !('equippedAvatarFrame' in data)
          || (
            data.equippedAvatarFrame is map
            && data.equippedAvatarFrame.keys().hasOnly(['itemId', 'assetUrl'])
            && data.equippedAvatarFrame.itemId is string
            && data.equippedAvatarFrame.itemId.matches('^[a-z0-9][a-z0-9_-]{2,79}$')
            && data.equippedAvatarFrame.assetUrl is string
            && data.equippedAvatarFrame.assetUrl.size() <= 2048
          )
        )
        && (
          !('equippedCosmetics' in data)
          || (
            data.equippedCosmetics is map
            && data.equippedCosmetics.keys().hasOnly(['avatarFrame', 'profileSkin', 'chatBubble', 'nameplate', 'cosmeticBadge', 'seatEffect'])
            && (
              !('avatarFrame' in data.equippedCosmetics)
              || (
                data.equippedCosmetics.avatarFrame is map
                && data.equippedCosmetics.avatarFrame.keys().hasOnly(['assetId', 'assetVersionId', 'itemId'])
                && data.equippedCosmetics.avatarFrame.assetId is string
                && data.equippedCosmetics.avatarFrame.assetId.matches('^[a-z0-9][a-z0-9_-]{2,79}$')
                && data.equippedCosmetics.avatarFrame.assetVersionId is string
                && data.equippedCosmetics.avatarFrame.assetVersionId.matches('^v[1-9][0-9]{0,8}-[a-f0-9]{12}$')
                && data.equippedCosmetics.avatarFrame.itemId is string
                && data.equippedCosmetics.avatarFrame.itemId.matches('^[a-z0-9][a-z0-9_-]{2,79}$')
              )
            )
            && (!('profileSkin' in data.equippedCosmetics) || validEquipmentCosmeticProjection(data.equippedCosmetics.profileSkin))
            && (!('chatBubble' in data.equippedCosmetics) || validEquipmentCosmeticProjection(data.equippedCosmetics.chatBubble))
            && (!('nameplate' in data.equippedCosmetics) || validEquipmentCosmeticProjection(data.equippedCosmetics.nameplate))
            && (!('cosmeticBadge' in data.equippedCosmetics) || validEquipmentCosmeticProjection(data.equippedCosmetics.cosmeticBadge))
            && (!('seatEffect' in data.equippedCosmetics) || validEquipmentCosmeticProjection(data.equippedCosmetics.seatEffect))
          )
        )
        && (data.moderationStatus == 'active' || data.moderationStatus == 'suspended' || data.moderationStatus == 'removed')
        && (data.avatarModerationStatus == 'clear' || data.avatarModerationStatus == 'pending' || data.avatarModerationStatus == 'removed')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validEquipmentCosmeticProjection(value) {
      return value is map
        && value.keys().hasOnly(['assetId', 'assetVersionId', 'itemId'])
        && value.assetId is string
        && value.assetId.matches('^[a-z0-9][a-z0-9_-]{2,79}$')
        && value.assetVersionId is string
        && value.assetVersionId.matches('^v[1-9][0-9]{0,8}-[a-f0-9]{12}$')
        && value.itemId is string
        && value.itemId.matches('^[a-z0-9][a-z0-9_-]{2,79}$');
    }

    function validCoupleEffectProjection(value) {
      return value is map
        && value.keys().hasOnly([
          'assetId',
          'assetVersionId',
          'borderMode',
          'coupleIdHash',
          'entranceMode',
          'fallbackAssetId',
          'fallbackAssetVersionId',
          'format',
          'itemId',
          'profileMode',
        ])
        && value.keys().hasAll([
          'assetId',
          'assetVersionId',
          'borderMode',
          'coupleIdHash',
          'entranceMode',
          'fallbackAssetId',
          'fallbackAssetVersionId',
          'format',
          'itemId',
          'profileMode',
        ])
        && value.assetId is string
        && value.assetId.matches('^[a-z0-9][a-z0-9_-]{2,79}$')
        && value.assetVersionId is string
        && value.assetVersionId.matches('^v[1-9][0-9]{0,8}-[a-f0-9]{12}$')
        && value.fallbackAssetId is string
        && value.fallbackAssetId.matches('^[a-z0-9][a-z0-9_-]{2,79}$')
        && value.fallbackAssetVersionId is string
        && value.fallbackAssetVersionId.matches('^v[1-9][0-9]{0,8}-[a-f0-9]{12}$')
        && value.itemId is string
        && value.itemId.matches('^[a-z0-9][a-z0-9_-]{2,79}$')
        && value.coupleIdHash is string
        && value.coupleIdHash.matches('^[a-f0-9]{64}$')
        && (value.format == 'png' || value.format == 'lottie-json')
        && (value.profileMode == 'off' || value.profileMode == 'static' || value.profileMode == 'looping')
        && (value.borderMode == 'off' || value.borderMode == 'static' || value.borderMode == 'looping')
        && (value.entranceMode == 'off' || value.entranceMode == 'static' || value.entranceMode == 'one-shot');
    }

    function validAccountDeletionRequest(userId) {
      let data = request.resource.data;
      return isOwner(userId)
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'avatarLabel',
          'status',
          'reason',
          'requestedAt',
          'updatedAt',
        ])
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.displayName == get(profilePath(request.auth.uid)).data.displayName
        && data.avatarLabel == get(profilePath(request.auth.uid)).data.avatarLabel
        && data.status == 'requested'
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 240))
        && data.requestedAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validProfile(userId);
      allow update: if false;
      allow delete: if false;

      match /accountDeletionRequests/{requestId} {
        allow read, create, update, delete: if false;
      }
    }

    match /accountLifecycles/{userId} {
      allow get: if authenticated() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /publicProfiles/{userId} {
      allow get: if signedIn()
        && resource.data.uid == userId
        && validPublicProfile(userId, resource.data)
        && (
          isOwner(userId)
          || (
            hasActivePublicProfile()
            && resource.data.moderationStatus == 'active'
            && !isBlockedBetween(userId)
          )
        );
      // Wave 0 exposes single-profile reads only. Collection discovery must go
      // through a server command so blocking can be enforced without treating
      // security rules as query filters or exceeding document-access limits.
      allow list: if false;
      allow create, delete: if false;
      allow update: if false;
    }

    match /avatarSubmissions/{uploadId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /avatarUploadAuthorizations/{userId} {
      allow read, write: if false;
    }

    match /appConfig/{configId} {
      allow read: if signedIn()
        && (
          configId == 'socialFeatures'
          || configId == 'personalChatsFrontendRollout'
          || configId == 'cosmeticsFeatures'
          || configId == 'growthFeatures'
          || configId == 'statusFeatures'
          || configId == 'voiceRoomFeatures'
          || configId == 'voiceRoomLaunch'
          || configId == 'roomRocketPublic'
          || configId == 'roomTargetPublic'
        );
      allow write: if false;
    }

    match /publicIds/{publicId} {
      allow read, write: if false;
    }

    match /specialIds/{specialId} {
      allow read, write: if false;
    }

    match /specialIdCatalog/{specialId} {
      allow read, write: if false;
    }

    match /socialCommandRequests/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /socialRateLimits/{userId} {
      allow read, write: if false;
    }

    match /socialFriendRateLimits/{userId} {
      allow read, write: if false;
    }

    match /socialCoupleRateLimits/{userId} {
      allow read, write: if false;
    }

    match /socialNotificationRateLimits/{userId} {
      allow read, write: if false;
    }

    match /roomSafetyRateLimits/{userId} {
      allow read, write: if false;
    }

    match /roomGameRateLimits/{userId} {
      allow read, write: if false;
    }

    match /roomMusicRateLimits/{userId} {
      allow read, write: if false;
    }

    match /roomWatchRateLimits/{userId} {
      allow read, write: if false;
    }

    match /voiceRoomHttpRateLimits/{rateId} {
      allow read, write: if false;
    }

    match /pushDevices/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /pushTokenOwners/{tokenId} {
      allow read, write: if false;
    }

    match /notificationPreferences/{userId} {
      allow read, write: if false;
    }

    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /notificationCoalesce/{coalesceId} {
      allow read, write: if false;
    }

    match /roomOwnershipNotifications/{userId}/items/{notificationId} {
      allow get, list: if hasActivePublicProfile()
        && request.auth.uid == userId
        && resource.data.recipientUid == userId;
      allow update: if hasActivePublicProfile()
        && request.auth.uid == userId
        && resource.data.recipientUid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt is timestamp;
      allow create, delete: if false;
    }

    match /roomGiftReceipts/{userId}/items/{receiptId} {
      allow get, list: if hasActivePublicProfile()
        && request.auth.uid == userId
        && (
          resource.data.senderUid == userId
          || resource.data.recipientUid == userId
        );
      allow write: if false;
    }

    match /deletedRoomArchives/{roomId} {
      allow read, write: if false;
    }

    match /adminUserSearch/{userId} {
      allow read, write: if false;
    }

    match /blocks/{blockerId}/{document=**} {
      allow read: if hasActivePublicProfile() && request.auth.uid == blockerId;
      allow write: if false;
    }

    match /following/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /followers/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /socialFollowRateLimits/{userId} {
      allow read, write: if false;
    }

    match /friendRequests/{requestId} {
      allow read, write: if false;
    }

    match /friendships/{friendshipId} {
      allow read, write: if false;
    }

    // Personal Chat Wave 3: persistent writes remain backend-only. Signed-in
    // participants may read only their own projection and bounded conversation
    // documents while the rollout flag is enabled.
    match /directConversations/{conversationId} {
      allow get: if isDirectChatMember(conversationId);
      allow list, write: if false;
    }

    match /directConversations/{conversationId}/messages/{messageId} {
      allow read: if isDirectChatMember(conversationId);
      allow write: if false;
    }

    match /directConversations/{conversationId}/receipts/{userId} {
      allow get: if isDirectChatMember(conversationId)
        && userId in get(directConversationPath(conversationId)).data.memberUids;
      allow list, write: if false;
    }

    match /directConversationMembers/{userId}/items/{conversationId} {
      allow get, list: if directMessagesEnabled()
        && hasActivePublicProfile()
        && request.auth.uid == userId
        && resource.data.ownerUid == userId;
      allow write: if false;
    }

    match /directChatInboxSummaries/{userId} {
      allow get: if directMessagesEnabled()
        && hasActivePublicProfile()
        && request.auth.uid == userId
        && resource.data.uid == userId;
      allow list, write: if false;
    }

    match /directMessageRequests/{conversationId} {
      allow get: if isDirectChatMember(conversationId)
        && resource.data.memberUids is list
        && request.auth.uid in resource.data.memberUids;
      allow list, write: if false;
    }

    match /directChatPresence/{conversationId}/typing/{userId} {
      allow read: if isAcceptedDirectChatMember(conversationId)
        && !hasActiveDirectChatRestriction()
        && !isBlockedBetween(directChatPeer(conversationId));
      allow create, update: if validDirectChatPresence(conversationId, userId, 'typing');
      allow delete: if isAcceptedDirectChatMember(conversationId) && request.auth.uid == userId;
    }

    match /directChatPresence/{conversationId}/online/{userId} {
      allow read: if isAcceptedDirectChatMember(conversationId)
        && !hasActiveDirectChatRestriction()
        && !isBlockedBetween(directChatPeer(conversationId))
        && isCurrentDirectChatFriend(conversationId);
      allow create, update: if validDirectChatPresence(conversationId, userId, 'online');
      allow delete: if isAcceptedDirectChatMember(conversationId) && request.auth.uid == userId;
    }

