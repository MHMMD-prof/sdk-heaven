    match /cosmeticAssets/{assetId} {
      // get: peers may resolve an already-equipped owner-bound asset by exact ID.
      allow get: if hasActivePublicProfile()
        && resource.data.keys().hasAll([
          'schemaVersion', 'assetId', 'publicationStatus', 'renderingEnabled', 'publishedVersionId',
        ])
        && resource.data.schemaVersion == 1
        && resource.data.assetId == assetId
        && resource.data.publicationStatus == 'published'
        && resource.data.renderingEnabled == true
        && resource.data.publishedVersionId is string;
      // list: owner-bound customs are not a public catalog.
      allow list: if hasActivePublicProfile()
        && resource.data.keys().hasAll([
          'schemaVersion', 'assetId', 'publicationStatus', 'renderingEnabled', 'publishedVersionId',
        ])
        && resource.data.schemaVersion == 1
        && resource.data.assetId == assetId
        && resource.data.publicationStatus == 'published'
        && resource.data.renderingEnabled == true
        && resource.data.publishedVersionId is string
        && (
          !('visibility' in resource.data)
          || resource.data.visibility != 'owner-bound'
        );
      allow create, update, delete: if false;

      match /versions/{versionId} {
        allow get: if hasActivePublicProfile()
          && resource.data.keys().hasAll(['schemaVersion', 'assetId', 'assetVersionId'])
          && resource.data.schemaVersion == 1
          && resource.data.assetId == assetId
          && resource.data.assetVersionId == versionId
          && get(/databases/$(database)/documents/cosmeticAssets/$(assetId)).data.publicationStatus == 'published'
          && get(/databases/$(database)/documents/cosmeticAssets/$(assetId)).data.renderingEnabled == true
          && get(/databases/$(database)/documents/cosmeticAssets/$(assetId)).data.publishedVersionId == versionId;
        allow list: if hasActivePublicProfile()
          && resource.data.keys().hasAll(['schemaVersion', 'assetId', 'assetVersionId'])
          && resource.data.schemaVersion == 1
          && resource.data.assetId == assetId
          && resource.data.assetVersionId == versionId
          && get(/databases/$(database)/documents/cosmeticAssets/$(assetId)).data.keys().hasAll([
            'publicationStatus', 'renderingEnabled', 'publishedVersionId',
          ])
          && get(/databases/$(database)/documents/cosmeticAssets/$(assetId)).data.publicationStatus == 'published'
          && get(/databases/$(database)/documents/cosmeticAssets/$(assetId)).data.renderingEnabled == true
          && get(/databases/$(database)/documents/cosmeticAssets/$(assetId)).data.publishedVersionId == versionId
          && (
            !('visibility' in get(/databases/$(database)/documents/cosmeticAssets/$(assetId)).data)
            || get(/databases/$(database)/documents/cosmeticAssets/$(assetId)).data.visibility != 'owner-bound'
          );
        allow create, update, delete: if false;
      }
    }

