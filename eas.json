{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_VOICE_ALLOW_MOCK_PROVIDER": "false",
        "EXPO_PUBLIC_VOICE_ALLOW_MOCK_ROOMS": "false",
        "EXPO_PUBLIC_VOICE_DEBUG": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
